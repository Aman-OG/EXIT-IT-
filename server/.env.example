# Server Configuration
PORT=5005
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=https://your-client-domain.vercel.app

# Database Connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=exit_it
DB_PASSWORD=your_db_password
